# IMAP-toegang tot de mailbox die de Opkikker/Kentaa-donatiemails ontvangt.
# Gebruik een los, dedicated e-mailadres, niet je persoonlijke mail.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Discord-webhook voor #beheerders (alleen zichtbaar voor Hart-Beheer)
DISCORD_WEBHOOK_URL=

# Poort waar Railway de server op verwacht (Railway zet deze meestal zelf)
PORT=3000
